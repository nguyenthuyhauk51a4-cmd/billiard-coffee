# Sao chép file này thành ".env" rồi điền thông tin MySQL của bạn (chỉ dùng khi chạy ở máy).
# Trên Vercel thì KHÔNG dùng file .env — nhập các biến này ở Settings → Environment Variables.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=billiard_coffee

# Đặt true nếu dùng MySQL trên mạng (TiDB Cloud, Aiven...). MySQL cài trên máy thì để false.
DB_SSL=false

# Chuỗi bí mật bất kỳ (dài, ngẫu nhiên) để mã hoá phiên đăng nhập
SESSION_SECRET=doi-chuoi-nay-thanh-chuoi-bi-mat-cua-quan-ban

# Cổng chạy web (chỉ dùng khi chạy ở máy)
# Múi giờ (mặc định giờ Việt Nam, thường không cần đổi)
# APP_TZ=Asia/Ho_Chi_Minh
# APP_TZ_OFFSET=+07:00

PORT=3000
